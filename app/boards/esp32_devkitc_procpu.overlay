#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		servo0 = &servo;
	};

	servo: servo {
		compatible = "umdloop,servo";
		pwms = <&ledc0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse-us = <544>;
		max-pulse-us = <2400>;
	};
};

&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH1_GPIO18>;
			output-enable;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
};